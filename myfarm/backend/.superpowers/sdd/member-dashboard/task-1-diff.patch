@@ -0,0 +1,34 @@
+# Features
+
+Business features are implemented here, one subdirectory per feature:
+
+```
+features/
+  authentication/   (Phase 02+)
+  dashboard/        (Phase 02+)
+  livestock/        (Phase 02+)
+  financial/        (Phase 02+)
+  inventory/        (Phase 02+)
+  collaboration/    (Phase 02+)
+  settings/         (Phase 02+)
+```
+
+Each feature follows Clean Architecture with feature-first layout:
+
+```
+features/<feature>/
+  data/
+    datasources/
+    models/
+    repositories/
+  domain/
+    entities/
+    repositories/
+    usecases/
+  presentation/
+    providers/
+    screens/
+    widgets/
+```
+
+Add route entries to `mobile/lib/app/app_routes.dart` as each feature is implemented.
diff --git a/myfarm/mobile/lib/main.dart b/myfarm/mobile/lib/main.dart
new file mode 100644
index 0000000..e86f0af
--- /dev/null
+++ b/myfarm/mobile/lib/main.dart
@@ -0,0 +1,17 @@
+import 'package:flutter/foundation.dart';
+import 'package:flutter/material.dart';
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:my_farm/app/app.dart';
+import 'package:my_farm/core/logging/app_logger.dart';
+
+void main() {
+  // Enable structured logging and Flutter errors in debug mode
+  FlutterError.onError = (FlutterErrorDetails details) {
+    AppLogger.e(details.exception.toString(), stackTrace: details.stack);
+    if (kDebugMode) {
+      FlutterError.dumpErrorToConsole(details);
+    }
+  };
+
+  runApp(const ProviderScope(child: MyApp()));
+}
